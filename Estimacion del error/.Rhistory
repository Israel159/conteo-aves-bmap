# ─── 1. Tu tabla original a formato largo ────────────────────────
totales_long <- totales %>%
pivot_longer(
cols = c(Adultos, Juveniles),
names_to = "Edad",
values_to = "Real"
) %>%
mutate(Real = replace_na(Real, 0))
View(totales_long)
mapeo_clases <- tribble(
~nombre_final,            ~ESPECIE, ~modo,
"zarcillo",               "INTE",   "suma",
"piquero adulto",         "PEBO",   "adulto",
"pinguino adulto",        "HUPE",   "adulto",
"piquero juvenil",        "PEBO",   "juvenil",
"pelicano adulto",        "PEPE",   "adulto",
"pinguino juvenil",       "HUPE",   "juvenil",
"pelicano juvenil",       "PEPE",   "juvenil",
"cushuri adulto",         "NECO",   "adulto",
"cushuri juvenil",        "NECO",   "juvenil",
"gallinazo cabeza roja",  "TUVU",   "suma",
"pichon pinguino",        "HUPE",   "fijo",
"chuita adulta",          "CHUCO",  "adulto",
"chuita",                 "CHUCO",  "suma",
"pichon piquero",         "PEBO",   "fijo",
"gaviota peruana adulta", "PEGU",   "adulto",
"guanay adulto",          "GUCO",   "adulto"
)
# ─── 3. Calcular cada clase ──────────────────────────────────────
# A) Clases que son suma de adulto + juvenil
clases_suma <- totales_long %>%
inner_join(
mapeo_clases %>% filter(modo == "suma"),
by = "ESPECIE"
) %>%
group_by(FOTO, nombre_final) %>%
summarise(Real = sum(Real), .groups = "drop")
# B) Clases específicas de edad
clases_edad <- totales_long %>%
inner_join(
mapeo_clases %>% filter(modo %in% c("adulto", "juvenil")),
by = "ESPECIE"
) %>%
filter(
(modo == "adulto"  & Edad == "Adultos") |
(modo == "juvenil" & Edad == "Juveniles")
) %>%
select(FOTO, nombre_final, Real)
# C) Pichones (no existen en tus datos actuales → 0)
#    Si tienes una tabla aparte con pichones, reemplaza este bloque
clases_fijo <- mapeo_clases %>%
filter(modo == "fijo") %>%
select(nombre_final) %>%
crossing(FOTO = unique(totales$FOTO)) %>%
mutate(Real = 0)
# ─── 4. Unir todo y ordenar ──────────────────────────────────────
ground_truth <- bind_rows(clases_suma, clases_edad, clases_fijo) %>%
mutate(nombre_final = factor(
nombre_final,
levels = c("zarcillo", "piquero adulto", "pinguino adulto",
"piquero juvenil", "pelicano adulto", "pinguino juvenil",
"pelicano juvenil", "cushuri adulto", "cushuri juvenil",
"gallinazo cabeza roja", "pichon pinguino", "chuita adulta",
"chuita", "pichon piquero", "gaviota peruana adulta",
"guanay adulto")
)) %>%
arrange(FOTO, nombre_final) %>%
rename(Clase = nombre_final)
# ─── 5. Verificar: cada foto tiene las 16 clases ─────────────────
ground_truth %>% count(FOTO)
# ─── 6. Vista tipo tabla del usuario ─────────────────────────────
ground_truth %>%
pivot_wider(
id_cols = FOTO,
names_from = Clase,
values_from = Real,
values_fill = 0
)
View(ground_truth)
