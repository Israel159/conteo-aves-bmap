# Opcional: si quieres nombres legibles en vez de códigos
Clase = case_when(
ESPECIE == "HUPE" & Edad == "Adultos" ~ "Pingüino adulto",
ESPECIE == "HUPE" & Edad == "Juveniles" ~ "Pingüino juvenil",
ESPECIE == "INTE" & Edad == "Adultos" ~ "Zarcillo adulto",
ESPECIE == "INTE" & Edad == "Juveniles" ~ "Zarcillo juvenil",
TRUE ~ paste(ESPECIE, Edad)
)
) %>%
# 3. Filtrar conteos en cero (opcional: quítalo si quieres conservar los 0)
filter(Real > 0) %>%
select(FOTO, Clase, Real)
View(ground_truth)
